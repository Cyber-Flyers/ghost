# Copy to ~/.config/ghost/ghost.env with mode 600; never commit the real file.
# Use literal values without shell quotes, export statements or substitutions.
url=https://blog.cyberflyers.org

# Must match MYSQL_PASSWORD in mysql.env.
database__connection__password=REPLACE_WITH_DATABASE_PASSWORD

# Use SMTP credentials for transactional mail; configure newsletters in Ghost Admin.
mail__transport=SMTP
mail__from=newsletter@cyberflyers.org
mail__options__host=smtp.mailgun.org
mail__options__port=587
mail__options__secure=false
mail__options__requireTLS=true
mail__options__auth__user=REPLACE_WITH_SMTP_USERNAME
mail__options__auth__pass=REPLACE_WITH_SMTP_PASSWORD
